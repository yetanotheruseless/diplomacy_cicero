FROM ubuntu:20.04

# Set noninteractive installation
ENV DEBIAN_FRONTEND=noninteractive

# PHASE 1: System dependencies
# ============================================== 
RUN apt-get update && apt-get install -y \
    wget \
    bzip2 \
    ca-certificates \
    curl \
    git \
    build-essential \
    cmake \
    autoconf \
    libtool \
    pkg-config \
    libgoogle-glog-dev \
    software-properties-common \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install GCC 9.4 to match the version in requirements
RUN apt-get update && \
    apt-get install -y gcc-9 g++-9 && \
    update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-9 90 && \
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-9 90 && \
    update-alternatives --install /usr/bin/cc cc /usr/bin/gcc-9 90 && \
    update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++-9 90 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install Python 3.8 and pip
RUN apt-get update && \
    apt-get install -y python3.8 python3.8-dev python3-pip && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Set up Python 3.8 as the default
RUN ln -sf /usr/bin/python3.8 /usr/bin/python && \
    ln -sf /usr/bin/pip3 /usr/bin/pip && \
    python -m pip install --upgrade pip setuptools wheel

# Verify GCC and Python versions
RUN echo "✅ Verifying system dependencies:" && \
    gcc --version | grep -q "9.4" && echo "  ✓ GCC 9.4 installed" && \
    python --version | grep -q "3.8" && echo "  ✓ Python 3.8 installed" && \
    cmake --version | grep -q "3.16" && echo "  ✓ CMake installed"

# PHASE 2: Protobuf installation
# ==============================================
# Install protobuf dependencies
RUN apt-get update && apt-get install -y git autoconf automake libtool curl unzip && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Build protobuf 3.19.1 from source (exact version required)
RUN git clone https://github.com/protocolbuffers/protobuf.git /tmp/protobuf && \
    cd /tmp/protobuf && \
    git checkout v3.19.1 && \
    ./autogen.sh && \
    ./configure && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    cd / && \
    rm -rf /tmp/protobuf

# Install Python protobuf package with matching version
RUN pip install protobuf==3.19.1

# Verify protobuf installation
RUN echo "✅ Verifying protobuf installation:" && \
    protoc --version | grep -q "3.19.1" && echo "  ✓ protoc 3.19.1 installed" && \
    python -c "import google.protobuf; print(google.protobuf.__version__)" | grep -q "3.19.1" && \
    echo "  ✓ Python protobuf 3.19.1 installed"

# Set working directory for the rest of the build
WORKDIR /app

# PHASE 3: Copy code and compile protobuf files
# ==============================================
# Copy the entire repository
COPY . /app/

# Install minimal dependencies for protobuf compilation
RUN pip install cython==0.29.24

# Compile protobuf files and validate the compilation
RUN echo "✅ Compiling protobuf files..." && \
    make protos_basic && \
    echo "  ✓ Protocol buffer files compiled successfully" && \
    python scripts/validate_protobuf.py

# PHASE 4: Build dipcc (C++ game logic)
# ==============================================
# Install pybind11 and the CPU-only Torch wheel used to compile pydipcc.
# The default 1.10.0 Linux wheel is CUDA-enabled, which makes
# find_package(Torch) require a CUDA toolkit even in this CPU image.
RUN pip install pybind11 numpy==1.20.3 cython==0.29.24 && \
    pip install torch==1.10.0+cpu \
        --index-url https://download.pytorch.org/whl/cpu && \
    python -c "import torch; assert torch.__version__ == '1.10.0+cpu'; assert torch.version.cuda is None"
RUN apt-get update && \
    apt-get install -y python3-dev pybind11-dev && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Fix directory structure for dipcc (nested directories)
RUN mkdir -p /app/dipcc/cc /app/dipcc/pybind && \
    cp -r /app/dipcc/dipcc/cc/* /app/dipcc/cc/ && \
    cp -r /app/dipcc/dipcc/pybind/* /app/dipcc/pybind/ && \
    cp -r /app/dipcc/dipcc/profiling /app/dipcc/

# Build dipcc with memory optimization
ARG DIPCC_BUILD_JOBS=2
RUN echo "✅ Building dipcc with $DIPCC_BUILD_JOBS parallel jobs..." && \
    cd /app/dipcc && \
    pybind11_DIR=$(python3 -c "import pybind11; print(pybind11.get_cmake_dir())") && \
    mkdir -p build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_PREFIX_PATH=$pybind11_DIR .. && \
    make -j${DIPCC_BUILD_JOBS} pydipcc && \
    cp dipcc/python/pydipcc*.so /app/fairdiplomacy/ && \
    echo "  ✓ Built pydipcc module successfully"

# PHASE 5: Test the dipcc installation
# ==============================================
# Run the pydipcc test
RUN echo "✅ Testing pydipcc module..." && \
    find /app/fairdiplomacy -name "pydipcc*.so" && \
    python /app/test_pydipcc.py

# PHASE 6: Validate the legacy CPU base dependencies
# ==============================================
# requirements.txt describes the original Python 3.7 / Torch 1.7.1 application
# stack: torchtext==0.8.1 requires torch==1.7.1. Installing it here would
# replace the Torch 1.10 CPU build dependency. Application dependencies are
# layered separately by scripts/setup_cicero_macos.sh or the modern Modal image.
RUN python -m pip check && \
    python -c "import sys, google.protobuf, numpy, torch; assert sys.version_info[:2] == (3, 8), sys.version; assert google.protobuf.__version__ == '3.19.1', google.protobuf.__version__; assert numpy.__version__ == '1.20.3', numpy.__version__; assert torch.__version__ == '1.10.0+cpu', torch.__version__; assert torch.version.cuda is None, torch.version.cuda"

# PHASE 7: Environment verification
# ==============================================
RUN echo "✅ Final environment verification:" && \
    echo "  Python version: $(python --version)" && \
    echo "  Platform: $(python -c 'import platform; print(platform.platform())')" && \
    echo "  Architecture: $(python -c 'import platform; print(platform.machine())')" && \
    echo "  Shared object files:" && \
    find /app -name "*.so" | grep -i pydipcc || echo "  ⚠️ No pydipcc.so files found"

# PHASE 8: Full build verification
# ==============================================
RUN echo "✅ Running comprehensive build verification..." && \
    chmod +x /app/scripts/verify_full_build.sh && \
    /app/scripts/verify_full_build.sh && \
    echo "  ✓ Full build verification PASSED" && \
    echo "" && \
    echo "✅ Build complete! Use the following to test the environment:" && \
    echo "  python /app/test_pydipcc.py" && \
    echo "  ./scripts/verify_full_build.sh"

# Default command
CMD ["/bin/bash"]
