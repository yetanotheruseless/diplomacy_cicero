# Version control and CI metadata
.git/
.gitignore
.gitattributes
.github/
.circleci/
.doctrack/

# Local editor and operating-system state
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Python caches, virtual environments, and packaging output
__pycache__/
*.py[cod]
*$py.class
.Python
.env
.env.*
!.env.example
.venv/
.venv-*/
venv/
env/
ENV/
.eggs/
*.egg
*.egg-info/
build/
develop-eggs/
dist/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
.installed.cfg

# Test, type-check, and lint caches
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.pytest_cache/
.pyright/
.ruff_cache/

# Native and generated build artifacts. The image regenerates these itself.
*.o
*.a
*.so
*.dylib
conf/*_pb2.py
conf/*_pb2.pyi
conf/*_cfgs.py
conf/*_cfgs.pyi
dipcc_pkg/

# Model weights are mounted at runtime and must never enter the build context.
models/
models_encrypted/
.cicero_model_stage/

# Local run output and diagnostics
*.bak
*.log
*.partial.json
game_state.json

# Compose configuration is not needed by the image build.
docker-compose.yml
docker-compose.*.yml
